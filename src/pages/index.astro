---
// `/` shows the coming-soon page while PUBLIC_COMING_SOON is 'true' (set in deploy.yml). The real home page is
// src/components/HomePage.astro, always reachable (noindex) at /preview/. Flip the flag off at launch.
import HomePage from '../components/HomePage.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { comingSoon } from '../config/site';
---
{comingSoon ? <ComingSoon /> : <HomePage />}
