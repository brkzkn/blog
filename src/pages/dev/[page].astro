---
// Dev-only review page (prototype/feed-types.html): every feed entry type with its variants, drawn by the
// same Entry component as the home feed. Absent from production builds.
import Base from '../../layouts/Base.astro';
import Entry from '../../components/feed/Entry.astro';
import { feedTypeExamples, feedRefEntries, feedTypeLabels } from '../../data/feed-type-examples';

// Dynamic route on purpose: Astro ignores getStaticPaths on a static route, so this keeps it out of production.
export function getStaticPaths() {
  return import.meta.env.PROD ? [] : [{ params: { page: 'feed-types' } }];
}

const byId = new Map(feedRefEntries.map((e) => [e.id, e]));
const groups = feedTypeExamples.map((g) => ({
  ...g,
  items: g.variants.map((v, i) => {
    const entry = v.ref ? byId.get(v.ref) : v.entry;
    if (!entry) throw new Error('Unknown example: ' + (v.ref ?? v.label));
    return { n: i + 1, v, entry };
  }),
}));
---
<Base title="Feed types review" description="Review page: every home feed entry type with its variants. Sample content." noindex nav={null}>
<Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>

<section class="review-intro"><div class="wrap">
<p class="cat" lang="tr">FEED TÜRLERİ · İNCELEME</p>
<h1 class="h2" lang="tr">Feed türleri.</h1>
<p class="body-l muted" lang="tr">Ana sayfadaki on kayıt türü, her birinin farklı hâlleriyle tek sayfada. Buradaki her kayıt ana sayfayla aynı kodla çizilir: burada gördüğün, akışta göreceğin şeydir.</p>
<p class="small" lang="tr">Sol sütundaki küçük etiket (örneğin <span class="review-variant">2 · Kısa</span>) varyant numarasıdır, sitede görünmez. Karşılaştırırken dil (TR/EN) ve tema (açık/koyu) düğmelerini de dene.</p>
</div></section>

<section class="review-section">
  <div class="wrap grid review-grid">
    <div class="span8 col timeline-stream review-main" style="gap: 0" data-review>
      {groups.map((g) => (
        <section class="review-type" id={`type-${g.type}`} aria-labelledby={`h-${g.type}`}>
          <header class="review-head"><p class="cat">TYPE · <code>{g.type}</code></p><h2 class="h3" id={`h-${g.type}`}>{feedTypeLabels[g.type]}</h2>
          <p class="small" lang="tr">{g.use}</p><p class="tiny" lang="tr">{g.fields}</p>
          <ol class="review-variants" lang="tr">{g.items.map((x) => <li><b>{x.v.label}</b> — {x.v.note}</li>)}</ol>
          {g.review && <p class="review-note small" lang="tr"><b>İnceleme notu</b> {g.review}</p>}</header>
          <div class="review-stream">
            {g.items.map((x, i) => (
              <Entry entry={x.entry} first={i === 0} last={i === g.items.length - 1}>
                <span slot="meta" class="review-variant-row"><span class="review-variant">{x.n} · {x.v.label}</span></span>
              </Entry>
            ))}
          </div>
        </section>
      ))}
    </div>
    <aside class="span4 journal-sidebar review-toc" aria-label="Types">
      <section class="sidebar-module sidebar-shortcuts" data-review-toc>
        <p class="sidebar-kicker" lang="tr">TÜRE GİT</p>
        {groups.map((g) => <a href={`#type-${g.type}`}><span>{feedTypeLabels[g.type]}</span><span class="sidebar-count">{g.variants.length}</span></a>)}
      </section>
      <section class="sidebar-module"><p class="sidebar-kicker" lang="tr">GERİ</p><p class="small"><a class="link" href="/" lang="tr">Ana sayfa akışı →</a></p></section>
    </aside>
  </div>
</section>

<script>
  // Dev review only. Line runs through a section, not between sections; entry titles are exposed as level 3; TOC marks the current section.
  const host = document.querySelector('[data-review]');
  const toc = document.querySelector('[data-review-toc]');
  if (host) {
    host.querySelectorAll('.review-stream').forEach((s) => {
      const a = s.querySelectorAll('.fe-entry');
      a[0]?.classList.add('is-first');
      a[a.length - 1]?.classList.add('is-last');
    });
    host.querySelectorAll('.review-stream h2').forEach((h) => h.setAttribute('aria-level', '3'));
    if (toc && 'IntersectionObserver' in window) {
      const links = [...toc.querySelectorAll('a')];
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => (a.getAttribute('href') === '#' + e.target.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        });
      }, { rootMargin: '0px 0px -70% 0px' });
      host.querySelectorAll('.review-type').forEach((t) => io.observe(t));
    }
  }
</script>
</Base>
