---
// Life index (prototype/life.html). Entries come from the posts collection (categories family, travel, culture).
// The category filter is the TS island src/scripts/life-filters.ts; it uses data-life-* attributes so the shared
// home-feed filter script (data-filter / data-category) does not bind to this page as well.
import Base from '../../layouts/Base.astro';
import OriginChip from '../../components/life/OriginChip.astro';
import Stars from '../../components/life/Stars.astro';
import { getPosts, postSlug, postUrl } from '../../lib/posts';
import { parseBody, monthYear, isoMonth } from '../../lib/life-body';

const CATEGORY_LABEL: Record<string, string> = { family: 'Family', travel: 'Travel', culture: 'Culture' };
// Placeholder hue per kind of entry (sample imagery only; real photos replace the .ph block).
const HUE: Record<string, string> = { 'Culture diary': 'plum', Books: 'sand', Theatre: 'plum', Museums: 'blue', Family: 'sage', Milestone: 'sage' };
const TYPES = ['note', 'album', 'review', 'milestone', 'trip', 'monthly', 'restaurant'];

const posts = (await getPosts()).filter(
  (p) => p.data.category in CATEGORY_LABEL && TYPES.includes(p.data.type) && !(p.data.type === 'restaurant' && p.data.sample),
);
const entries = posts.map((p) => {
  const d = p.data;
  const body = parseBody(p.body ?? '');
  const href =
    d.type === 'monthly' ? `/life/culture/${isoMonth(d.date)}/`
    : d.type === 'trip' ? `/life/trips/${postSlug(p)}/`
    : d.type === 'restaurant' ? `/life/restaurants/${postSlug(p)}/`
    : d.sample ? undefined // sample notes have no page of their own yet, so they stay unavailable
    : postUrl(p);
  const label = d.type === 'monthly' ? 'Culture diary' : d.type === 'trip' ? `Travel, ${d.days} days` : d.tags[0] ?? CATEGORY_LABEL[d.category];
  const hue = d.type === 'trip' ? 'deep' : HUE[label] ?? 'sage';
  return {
    p, d, href, label, hue,
    title: d.type === 'restaurant' ? d.name ?? d.title : d.title,
    text: body.sections.get('Summary')?.before[0] ?? body.lede,
    cap: d.alt[0] ?? d.title ?? '',
    tag: d.type === 'milestone' ? 'Milestone' : CATEGORY_LABEL[d.category],
  };
});
---
<Base title="Life" description="Milestones, trips, what we watched and read, and the ordinary days that turned out to matter. Written for us, left open for anyone." originalLang="en">
<div class="wrap original-language-note" data-original-note hidden></div>

<section class="pagehead">
  <div class="wrap grid pagehead-life">
    <div class="span7 col pagehead-text">
      <h1 class="h1">The life I want to remember.</h1>
      <p class="lede">Milestones, trips, what we watched and read, and the ordinary days that turned out to matter. Written for us, left open for anyone. <span class="mock">entries are samples</span></p>
    </div>
    <div class="span5 pagehead-photos">
      <div class="ph r43 sage"><span class="cap">Photo: the four of us from behind, Caddebostan shore</span></div>
      <div class="ph r34 plum"><span class="cap">Photo: ticket stubs</span></div>
    </div>
  </div>
</section>

<section class="section tight filterbar">
  <div class="wrap">
    <div class="filters"><button data-life-filter="all" type="button" aria-pressed="true">All</button><button data-life-filter="family" type="button" aria-pressed="false">Family &amp; milestones</button><button data-life-filter="travel" type="button" aria-pressed="false">Travel</button><button data-life-filter="culture" type="button" aria-pressed="false">Culture</button></div>
  </div>
</section>

<section class="section life-feed">
  <div class="wrap">
    <div class="feed">
      {entries.map((e) => (
      <article class={e.d.type === 'milestone' ? 'item milestone' : 'item'} data-life-category={e.d.category}>
        <p class="when"><time datetime={isoMonth(e.d.date)}>{monthYear(e.d.date)}</time><small>{e.label}</small></p>
        <div class="col item-body">
          <div class="row item-meta"><span class="tag fill">{e.tag}</span>{e.d.rating && e.d.type !== 'restaurant' && <Stars value={e.d.rating} />}<OriginChip lang={e.d.lang} /></div>
          {e.d.type === 'milestone'
            ? <h2 class="h2">{e.href ? <a href={e.href}>{e.title}</a> : <span class="unavailable">{e.title}</span>}</h2>
            : <h2 class="h3">{e.href ? <a href={e.href}>{e.title}</a> : <span class="unavailable">{e.title}</span>}</h2>}
          <p class={e.d.type === 'milestone' ? 'body item-text' : 'small item-text'}>{e.text}</p>
          {e.d.type === 'trip' && <p class="tiny">Itinerary and practical notes</p>}
        </div>
        {e.href && ['monthly', 'trip', 'restaurant'].includes(e.d.type)
          ? <a class={`ph r32 ${e.hue}`} href={e.href} tabindex="-1" aria-hidden="true"><span class="cap">{e.cap}</span></a>
          : <div class={`ph r32 ${e.hue}`} aria-hidden="true"><span class="cap">{e.cap}</span></div>}
      </article>
      ))}
    </div>
  </div>
</section>
<script>import '../../scripts/life-filters.ts';</script>
</Base>
