---
// profile.html. Career, focus and contact blocks are page markup; the "Away from the keyboard" prose is the `about` page entry.
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site, social } from '../../config/site';
const linkedin = social('linkedin');
const github = social('github');

const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(about);
const lang = about.data.lang;
const origin = lang === 'tr' ? 'Written in Turkish' : 'Written in English';
---
<Base title="About" description={about.data.description} originalLang={lang}>

<section class="pagehead about-pagehead">
  <div class="wrap grid about-hero">
    <div class="span4"><div class="ph r34 deep"><span class="cap">Portrait: natural light, not at a desk</span></div></div>
    <div class="about-hero-text about-stack-lg">
      <p class="tiny"><span class="origin-chip" title={origin}>{lang.toUpperCase()}</span></p>
      <h1 class="h1">I design backend systems for a living, and I build things at home to think.</h1>
      <p class="lede">Technical Architect in Istanbul. Fifteen-plus years in software, the last eight spent on architecture: service boundaries, event-driven systems, and the operational side nobody draws on the whiteboard. Outside work: a house run by Home Assistant, a workshop with two printers, and twin daughters who are faster than both.</p>
      <div class="row about-actions">
        <a class="btn primary" href="#contact">Get in touch</a>
        <a class="btn unavailable">Download CV (PDF)</a>
        {linkedin && <a class="btn" href={linkedin.href} target="_blank" rel="noopener noreferrer">{linkedin.label}</a>}
        {github && <a class="btn" href={github.href} target="_blank" rel="noopener noreferrer">{github.label}</a>}
      </div>
    </div>
  </div>
</section>

<section class="section about-rule">
  <div class="wrap grid">
    <div class="span4 about-stack"><h2 class="h2">Career, briefly</h2><p class="small">The long version is in the CV. {about.data.sample && <span class="mock">dates and companies are placeholders</span>}</p></div>
    <div class="span8">
        <div class="cv-row"><div class="tiny">2022 to now</div><div class="about-stack"><h3 class="h4">Technical Architect, [Company]</h3><p class="small">Architecture lead for a retail group’s order and fulfilment platforms. Two squads, four brands, one event log.</p></div></div>
        <div class="cv-row"><div class="tiny">2018 to 2022</div><div class="about-stack"><h3 class="h4">Software Architect, [Company]</h3><p class="small">Ledger and payments systems for a fintech; event sourcing in production, audits passed without anyone pulling an all-nighter.</p></div></div>
        <div class="cv-row"><div class="tiny">2014 to 2018</div><div class="about-stack"><h3 class="h4">Senior Backend Engineer, [Company]</h3><p class="small">Logistics platform; moved nightly batch to streaming, learned what “eventually consistent” costs a support team.</p></div></div>
        <div class="cv-row"><div class="tiny">2010 to 2014</div><div class="about-stack"><h3 class="h4">Backend Engineer, [Company]</h3><p class="small">Media and content platforms. The years where I learned that databases are the hard part.</p></div></div>
    </div>
  </div>
</section>

<section class="section about-rule">
  <div class="wrap grid">
    <div class="span4 about-stack"><h2 class="h2">Technical focus</h2><p class="small">What I reach for, and what I am careful with.</p></div>
    <div class="span8 g2 about-focus">
      <div class="panel about-stack"><h3 class="h4">Architecture</h3><p class="small">Domain-driven design, bounded contexts, event-driven integration, CQRS where the read side earns it, strangler migrations off monoliths.</p></div>
      <div class="panel about-stack"><h3 class="h4">Backend</h3><p class="small">.NET, PostgreSQL, Kafka, Redis, gRPC and REST. Strong opinions about idempotency and the outbox pattern.</p></div>
      <div class="panel about-stack"><h3 class="h4">Platform</h3><p class="small">Kubernetes, GitOps, OpenTelemetry. Golden paths that make the compliant route the easy one.</p></div>
      <div class="panel about-stack"><h3 class="h4">Working with AI</h3><p class="small">Provider-independent application design, prompt versioning, eval datasets. Interested in what a small local model can do reliably.</p></div>
    </div>
  </div>
</section>

<section class="section about-rule">
  <div class="wrap grid about-away">
    <div class="span6 about-stack-lg">
      <h2 class="h2">Away from the keyboard</h2>
      <div class="prose"><Content /></div>
    </div>
    <div class="about-photos">
      <div class="ph r34 warm photo-placeholder"><span class="cap">Photo: workshop</span><img src="/assets/images/stock-3d-printer.jpg" alt="Illustrative photo: workshop" loading="lazy"></div>
      <div class="ph r34 sage about-stagger"><span class="cap">Photo: stadium, evening</span></div>
    </div>
  </div>
</section>

<section class="section about-rule">
  <div class="wrap grid">
    <div class="span4"><h2 class="h2" id="contact">Get in touch</h2></div>
    <div class="span8 about-contact" id="social-profiles">
      <div class="panel about-stack"><span class="tiny">Email</span><a class="link about-contact-link" href={`mailto:${site.email}`}>{site.email}</a><span class="small">Best for anything longer than a sentence.</span></div>
      {linkedin && <div class="panel about-stack"><span class="tiny">LinkedIn</span><a class="link about-contact-link" href={linkedin.href} target="_blank" rel="noopener noreferrer">{linkedin.display}</a><span class="small">Work, roles, the occasional post.</span></div>}
      {github && <div class="panel about-stack"><span class="tiny">GitHub</span><a class="link about-contact-link" href={github.href} target="_blank" rel="noopener noreferrer">{github.display}</a><span class="small">Experiments and printable parts.</span></div>}
      <div class="panel tint about-cv"><div class="about-stack"><h3 class="about-cv-title">Curriculum vitae</h3><span class="small">Two pages, updated October 2026</span></div><a class="btn sm primary unavailable">Download PDF</a></div>
    </div>
  </div>
</section>
</Base>
