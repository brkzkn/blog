---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." noindex nav={null}>
  <section style="padding: 96px 0 120px">
    <div class="wrap col" style="gap: 24px; max-width: 720px">
      <p class="small" style="display: flex; gap: 12px; align-items: center"><span style="display: inline-block; width: 28px; height: 1px; background: var(--orange)"></span>404</p>
      <h1 class="h1">This page is not here.</h1>
      <p class="body-l muted">The link may be old, or the note was never published. The journal and the work pages are a good place to start again.</p>
      <div class="hero-actions"><a class="btn primary" href="/">Back to the journal →</a><a class="btn" href="/work/">Architecture work</a></div>
    </div>
  </section>
</Base>
