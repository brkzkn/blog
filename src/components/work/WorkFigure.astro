---
// Case-study image slot (see the comment in prototype/work.html): a figure.wk-fig holds either the entry's
// real photo (`cover`, 56:19) or its drawing (`diagram`, an SVG under public/, inlined). Keep frame and caption.
import { Image } from 'astro:assets';
import { readDiagram } from '../../lib/work';
import type { Work } from '../../lib/work';

interface Props { work: Pick<Work['data'], 'title' | 'cover' | 'diagram'>; caption?: string }
const { work, caption } = Astro.props;
const art = !work.cover && work.diagram ? readDiagram(work.diagram) : null;
const cap = caption ?? art?.caption;
---
{(work.cover || art) && (
  <figure class="wk-fig">
    {work.cover ? <Image src={work.cover} alt={work.title} widths={[560, 1120]} sizes="(max-width: 1000px) 100vw, 560px" /> : <Fragment set:html={art!.svg} />}
    {cap && <figcaption>{cap}</figcaption>}
  </figure>
)}
