---
// Social link buttons for the home sidebar ("Elsewhere"). Same markup as before; the list comes from src/config/site.ts,
// so a disabled profile (Instagram) is simply not rendered and enabling it is a one-line change there.
import { enabledSocials, type Social } from '../config/site';
const icons: Record<Social['id'], string> = {
  linkedin: '<rect x="1" y="1" width="14" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M4.5 6.5v5M4.5 4.2v.1M7.5 11.5V8.8c0-1.3.8-2.3 2-2.3s2 .9 2 2.3v2.7" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/>',
  instagram: '<rect x="1.5" y="1.5" width="13" height="13" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="11.6" cy="4.4" r=".8" fill="currentColor"/>',
  github: '<path d="M5.5 4 2 8l3.5 4M10.5 4 14 8l-3.5 4M9 3 7 13" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
};
---
{enabledSocials.map((s) => (
  <a class="btn sm" href={s.href} target="_blank" rel="noopener noreferrer"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" set:html={icons[s.id]} />{s.label}</a>
))}
