---
import { fixHref, fixSrc } from '../../lib/feed';
const { entry: e } = Astro.props;
const href = fixHref(e.href);
---
<div class="fe-monthly"><div class="fe-collage" role="group" aria-label="Cover collage, illustrative images">{e.collage.map((p: any, i: number) => <img class={`c${i}`} src={fixSrc(p.src)} alt={p.alt} loading="lazy" decoding="async">)}</div>
<div class="fe-monthly-text"><h2 class="h3"><a href={href}>{e.title}</a></h2>
<ul class="fe-counts">{e.counts.map(([n, l]: string[]) => <li><b>{n}</b> <span>{l}</span></li>)}</ul>
<blockquote class="fe-highlight"><p class="fe-kicker">Highlight of the month</p><p lang={e.language}>{e.highlight}</p></blockquote>
<p class="fe-meta tiny"><a class="link" href={href}>See the full month <span aria-hidden="true">→</span></a></p></div></div>
