---
import AlbumGrid from './AlbumGrid.astro';
import CtaRow from './CtaRow.astro';
const { entry: e } = Astro.props;
const n = e.photos.length;
---
{e.title && <h2 class="h4">{e.title}</h2>}<p class="fe-caption" lang={e.language}>{e.caption}</p>
<AlbumGrid entry={e} name={e.title || e.place} />
<p class="fe-meta tiny"><span>{e.place}</span><span>{n} photo{n === 1 ? '' : 's'}</span></p><CtaRow href={e.href} label={e.linkLabel} />
