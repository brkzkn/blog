---
// Small line illustrations drawn in code (no photos): writing art, milestone twins, link preview chip.
const { name } = Astro.props;
---
{name === 'architecture' && <svg class="fe-art" viewBox="0 0 240 180" role="img" aria-label="Diagram: constraints lead to a small design that is tested, instead of an ideal diagram drawn first"><rect x="14" y="14" width="76" height="34" rx="3" class="dash"/><path d="M26 31h52" class="dash"/><rect x="14" y="73" width="76" height="34" rx="3"/><rect x="14" y="132" width="76" height="34" rx="3"/><rect x="150" y="73" width="76" height="34" rx="3" class="hot"/><path d="M90 90h60M52 107v25M52 48v25" class="line"/><path d="M144 85l6 5-6 5M46 126l6 6 6-6" class="line"/><circle cx="188" cy="90" r="5" class="hotfill"/></svg>}
{name === 'twins' && <svg class="fe-art fe-twins" viewBox="0 0 240 150" role="img" aria-label="Illustration: two small figures seen from behind under one arch"><path d="M20 140v-40a100 100 0 0 1 200 0v40" class="line"/><circle cx="100" cy="86" r="14"/><path d="M78 140c0-26 9-38 22-38s22 12 22 38"/><circle cx="148" cy="86" r="14" class="hot"/><path d="M126 140c0-26 9-38 22-38s22 12 22 38" class="hot"/><path d="M10 140h220" class="line"/></svg>}
{name === 'chip' && <svg class="fe-art" viewBox="0 0 320 180" role="img" aria-label="Placeholder preview: a small circuit board"><rect x="110" y="50" width="100" height="80" rx="4"/><path d="M130 50V30m30 20V30m30 20V30M130 130v20m30-20v20m30-20v20M110 70H90m20 20H90m20 20H90M210 70h20m-20 20h20m-20 20h20" class="line"/><circle cx="160" cy="90" r="10" class="hotfill"/></svg>}
