---
import AlbumGrid from './AlbumGrid.astro';
import CtaRow from './CtaRow.astro';
const { entry: e } = Astro.props;
const n = e.photos.length;
---
<div class="fe-trip"><p class="fe-kicker" lang={e.language}>{e.country}</p><h2 class="h3" lang={e.language}>{e.destination}</h2>
<p class="fe-trip-meta tiny"><span>{e.dates}</span>{e.days && <span>{e.days}</span>}</p>
<p class="fe-caption" lang={e.language}>{e.caption}</p>
<AlbumGrid entry={e} name={e.destination} />
<CtaRow href={e.href} label={e.linkLabel}><span class="tiny">{n} photo{n === 1 ? '' : 's'}</span></CtaRow></div>
