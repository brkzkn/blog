---
// Site header: brand, preference toggles, primary nav. Markup is the prototype's, byte for byte in structure.
// `current` is the nav section to mark active (computed by Base from Astro.url unless a page overrides it).
export type NavSection = 'home' | 'work' | 'projects' | 'life' | 'gear' | 'writing' | 'about' | null;
import { localizePath, type Locale } from '../i18n';
import { translations } from '../scripts/i18n/tr';
interface Props { current: NavSection }
const { current } = Astro.props;
const locale: Locale = Astro.currentLocale === 'tr' ? 'tr' : 'en';
const t = (text: string) => (locale === 'tr' ? translations[text] ?? text : text);
const link = (path: string) => localizePath(path, locale);
const items: { id: Exclude<NavSection, null>; href: string; label: string }[] = [
  { id: 'home', href: '/', label: 'Home' },
  { id: 'work', href: '/work/', label: 'Work' },
  { id: 'projects', href: '/projects/', label: 'Projects' },
  { id: 'life', href: '/life/', label: 'Life' },
  { id: 'gear', href: '/gear/', label: 'Gear' },
  { id: 'writing', href: '/writing/', label: 'Writing' },
  { id: 'about', href: '/about/', label: 'About' },
];
---
<header class="nav"><div class="wrap"><a class="brand" href={link('/')}>Burak Özkan <small>Istanbul</small></a><button class="menubtn" type="button" aria-expanded="false" aria-controls="primary-menu" aria-label="Menu"><span class="menubtn-bars" aria-hidden="true"><i></i><i></i><i></i></span></button><div class="site-preferences"><button id="language-toggle" class="preference-icon language-toggle" type="button" aria-label={locale === 'tr' ? 'Switch to English' : 'Switch to Turkish'} title={locale === 'tr' ? 'Switch to English' : 'Switch to Turkish'}><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg><span data-language-code>{locale.toUpperCase()}</span></button><button id="theme-toggle" class="preference-icon" type="button" aria-label="Switch to dark mode" title="Switch to dark mode" aria-pressed="false"><svg class="moon-icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M20.9 14.2A9 9 0 0 1 9.8 3.1 9 9 0 1 0 20.9 14.2Z"/></svg><svg class="sun-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg></button></div><nav id="primary-menu" aria-label={t('Primary')}><ul>{items.map((i) => (<li><a class:list={[{ on: i.id === current }]} aria-current={i.id === current ? 'page' : undefined} href={link(i.href)}>{t(i.label)}</a></li>))}</ul></nav></div></header>
